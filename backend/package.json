{
  "name": "imagetotextonline-backend",
  "version": "1.0.0",
  "description": "Backend server for ImageToTextOnline OCR application",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --verbose",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --verbose __tests__/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --verbose __tests__/integration",
    "test:security": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --verbose __tests__/security"
  },
  "keywords": [
    "ocr",
    "tesseract",
    "image-to-text"
  ],
  "author": "ImageToTextOnline",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.7.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.6",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
